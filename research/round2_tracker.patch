diff --git a/vision/tracker.py b/vision/tracker.py
new file mode 100644
index 0000000..2207ca3
--- /dev/null
+++ b/vision/tracker.py
@@ -0,0 +1,170 @@
+# Follows people from one picture to the next, also on pictures where the AI did not look.
+#
+# Big idea (from the SORT / ByteTrack tracking videos):
+#   - Every picture: move each person's box by how the pixels inside it moved
+#     (optical flow). This is cheap, so the AI does not have to run on every picture.
+#   - When the AI did look: match what it found to the boxes we already follow
+#     (best overlap first). Sure detections first, unsure ones only to keep an existing person.
+#   - Someone the AI misses keeps their number for a while (hidden behind someone,
+#     bending down), so they get the SAME number back when they show up near the same spot.
+#
+# The numbers are only labels for this session. Nothing about faces is stored.
+
+import cv2
+import numpy as np
+
+FLOW_WIDTH = 640           # optical flow runs on a small copy of the picture (fast)
+FLOW_POINTS = 25           # corner points followed inside each box
+FLOW_MAX_LOST = 1.0        # seconds: stop moving a box by flow when the AI hasn't seen it for this long
+MATCH_IOU = 0.2            # boxes must overlap at least this much to be the same person
+REFIND_DISTANCE = 1.0      # a lost person can be found again this many box-heights from where they were
+
+
+def box_area(b):
+    return max(0, b[2] - b[0]) * max(0, b[3] - b[1])
+
+
+def iou(a, b):
+    x1, y1, x2, y2 = max(a[0], b[0]), max(a[1], b[1]), min(a[2], b[2]), min(a[3], b[3])
+    inter = box_area([x1, y1, x2, y2])
+    union = box_area(a) + box_area(b) - inter
+    if union <= 0:
+        return 0
+    return inter / union
+
+
+def center(b):
+    return (b[0] + b[2]) / 2, (b[1] + b[3]) / 2
+
+
+def inside_any(b, rects):
+    if rects is None:
+        return True
+    cx, cy = center(b)
+    for r in rects:
+        if r[0] <= cx <= r[2] and r[1] <= cy <= r[3]:
+            return True
+    return False
+
+
+class Tracker:
+    def __init__(self, new_confidence, forget_seconds):
+        self.new_confidence = new_confidence   # a detection this sure can start a new person
+        self.forget_seconds = forget_seconds   # unseen this long = the number is retired
+        self.tracks = []
+        self.next_id = 1
+        self.prev_gray = None
+        self.scale = 1.0
+
+    # ---------- every picture ----------
+
+    def predict(self, frame, now):
+        # move every recently seen box with optical flow
+        h, w = frame.shape[:2]
+        self.scale = FLOW_WIDTH / w
+        small = cv2.resize(frame, (FLOW_WIDTH, int(h * self.scale)))
+        gray = cv2.cvtColor(small, cv2.COLOR_BGR2GRAY)
+        if self.prev_gray is not None:
+            for t in self.tracks:
+                if t["misses"] == 0 or now - t["last_seen"] <= FLOW_MAX_LOST:
+                    self.flow_move(t, self.prev_gray, gray)
+        self.prev_gray = gray
+
+    def flow_move(self, track, old_gray, new_gray):
+        s = self.scale
+        b = [v * s for v in track["box"]]
+        x1, y1 = max(0, int(b[0])), max(0, int(b[1]))
+        x2, y2 = min(old_gray.shape[1], int(b[2])), min(old_gray.shape[0], int(b[3]))
+        if x2 - x1 < 8 or y2 - y1 < 8:
+            return
+        mask = np.zeros_like(old_gray)
+        mask[y1:y2, x1:x2] = 255
+        pts = cv2.goodFeaturesToTrack(old_gray, FLOW_POINTS, 0.01, 4, mask=mask)
+        if pts is None or len(pts) < 4:
+            return
+        new_pts, status, err = cv2.calcOpticalFlowPyrLK(old_gray, new_gray, pts, None,
+                                                        winSize=(21, 21), maxLevel=3)
+        good = status.reshape(-1) == 1
+        if good.sum() < 4:
+            return
+        moves = (new_pts[good] - pts[good]).reshape(-1, 2)
+        dx = float(np.median(moves[:, 0])) / s
+        dy = float(np.median(moves[:, 1])) / s
+        track["box"] = [track["box"][0] + dx, track["box"][1] + dy, track["box"][2] + dx, track["box"][3] + dy]
+        for p in track["points"]:
+            p[0] = p[0] + dx
+            p[1] = p[1] + dy
+
+    # ---------- when the AI looked ----------
+
+    def update(self, people, now, searched=None):
+        # people: detections from the AI. searched: the parts of the picture the AI looked at
+        # (None = the whole picture). Read the result with current().
+        sure = [p for p in people if p["conf"] >= self.new_confidence]
+        unsure = [p for p in people if p["conf"] < self.new_confidence]
+        free_tracks = [t for t in self.tracks if inside_any(t["box"], searched)]
+        left = self.match(sure, free_tracks, now, allow_refind=True)
+        # unsure detections may only keep someone we already follow (ByteTrack's second pass)
+        free_tracks = [t for t in free_tracks if t["last_seen"] != now]
+        self.match(unsure, free_tracks, now, allow_refind=False)
+        for t in free_tracks:
+            if t["last_seen"] != now:
+                t["misses"] = t["misses"] + 1   # the AI looked here and did not find them
+        for p in left:
+            self.add_track(p, now)
+        self.tracks = [t for t in self.tracks if now - t["last_seen"] <= self.forget_seconds]
+
+    def match(self, dets, tracks, now, allow_refind):
+        pairs = []
+        for i in range(len(dets)):
+            d = dets[i]["box"]
+            for t in tracks:
+                score = iou(d, t["box"])
+                if score < MATCH_IOU and allow_refind and now - t["last_seen"] > 0:
+                    # lost for a moment: allow a match near where they were, if the size is similar
+                    tx, ty = center(t["box"])
+                    dx, dy = center(d)
+                    th = t["box"][3] - t["box"][1]
+                    dh = d[3] - d[1]
+                    near = ((tx - dx) ** 2 + (ty - dy) ** 2) ** 0.5 <= REFIND_DISTANCE * th
+                    similar = th > 0 and 0.5 <= dh / th <= 2.0
+                    if near and similar:
+                        score = MATCH_IOU * 0.5   # weaker than any real overlap
+                if score >= MATCH_IOU * 0.5:
+                    pairs.append((score, i, t["id"]))
+        pairs.sort(reverse=True)
+        used_d, used_t = set(), set()
+        by_id = {t["id"]: t for t in tracks}
+        for score, i, tid in pairs:
+            if i in used_d or tid in used_t:
+                continue
+            used_d.add(i)
+            used_t.add(tid)
+            self.refresh(by_id[tid], dets[i], now)
+        return [dets[i] for i in range(len(dets)) if i not in used_d]
+
+    def refresh(self, track, det, now):
+        track["box"] = list(det["box"])
+        track["points"] = [list(p) for p in det["points"]]
+        track["conf"] = det["conf"]
+        track["last_seen"] = now
+        track["hits"] = track["hits"] + 1
+        track["misses"] = 0
+
+    def add_track(self, det, now):
+        self.tracks.append({"id": self.next_id, "box": list(det["box"]),
+                            "points": [list(p) for p in det["points"]],
+                            "conf": det["conf"], "last_seen": now, "hits": 1, "misses": 0})
+        self.next_id = self.next_id + 1
+
+    # ---------- result ----------
+
+    def current(self, now, max_age):
+        # people to hand to the brain: found by the last AI check, or missed by only one check
+        # and seen in the last max_age seconds (a slow AI check must not hide everyone)
+        out = []
+        for t in self.tracks:
+            if t["misses"] == 0 or (t["misses"] <= 1 and now - t["last_seen"] <= max_age):
+                out.append({"box": list(t["box"]), "conf": t["conf"],
+                            "points": [list(p) for p in t["points"]], "track_id": t["id"]})
+        return out
